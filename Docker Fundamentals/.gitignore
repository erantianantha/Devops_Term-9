# Regenerated by the build, so never committed:
#   node_modules/  dist/   npm install and vite build recreate them
#   __pycache__/          bytecode, rebuilt on import
#   *.class               javac output
# The Dockerfiles rebuild all of it inside the image anyway, and .dockerignore
# keeps them out of the build context as well.
node_modules/
dist/
__pycache__/
*.pyc
*.class
.venv/
