# The build context is tarred up and shipped to the Docker daemon, so anything
# listed here is both faster to build and impossible to leak into the image.
# node_modules is the important one: it is large, it is regenerated by the
# RUN npm install inside the image anyway, and on Windows it can contain
# native binaries that simply will not execute on Alpine Linux.
node_modules
npm-debug.log*
.git
.dockerignore
Dockerfile
*.md
